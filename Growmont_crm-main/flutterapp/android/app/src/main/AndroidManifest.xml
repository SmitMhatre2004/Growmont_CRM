<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared explicitly rather than inherited. Flutter's template only
         puts INTERNET in the debug/ and profile/ manifests; release builds
         have so far picked it up by accident, via manifest merging from the
         Firebase/Play Services AARs. That is a dependency-ordering
         coincidence, not a guarantee — if it ever stopped holding, the
         release APK would ship with no network access at all while debug
         builds kept working. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Lets the in-app updater hand a downloaded APK to the system package
         installer. This permission alone is not sufficient: on Android 8+
         the user must also grant this app "install unknown apps" in system
         settings, which ApkInstaller checks for and routes to. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Growmont CRM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Android 7+ rejects a raw file:// URI handed to another app
             (FileUriExposedException), so the downloaded APK is passed to
             the package installer as a content:// URI granted through this
             provider. The authority is app-specific to avoid colliding with
             the providers share_plus/file_picker declare. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
